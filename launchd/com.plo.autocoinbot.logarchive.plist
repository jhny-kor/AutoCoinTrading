<?xml version="1.0" encoding="UTF-8"?>
<!--
수정 요약
- 로그 보관 배치를 매일 00:10 에 실행하는 전용 launchd 잡 유지
- 압축형이 아니라 삭제형 보관 정리를 실행하도록 인자를 prune 으로 변경
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.plo.autocoinbot.logarchive</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/plo/Documents/auto_coin_bot/scripts/run_log_archive_manager.sh</string>
    <string>prune</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/plo/Documents/auto_coin_bot</string>

  <key>RunAtLoad</key>
  <false/>

  <key>KeepAlive</key>
  <false/>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>0</integer>
    <key>Minute</key>
    <integer>10</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/plo/Documents/auto_coin_bot/logs/log_archive_manager.launchd.out</string>

  <key>StandardErrorPath</key>
  <string>/Users/plo/Documents/auto_coin_bot/logs/log_archive_manager.launchd.err</string>
</dict>
</plist>
