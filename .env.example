# =========================
# 변경 이력 / 세트 메모
# =========================
# - 2026-04-14: SOL 알트 거래 심볼 예시를 실제 운용 기준과 맞췄습니다.
# - 2026-04-03: .env.example 본문을 읽기 쉽게 재정리하고, 전략 세트는 env_overrides 의 canonical partial env 구조를 기준으로 정리
#
# canonical 세트 파일
# - env_overrides/conservative.env
# - env_overrides/medium.env
# - env_overrides/mixed.env
#
# 읽는 순서
# 1) 거래소 / 텔레그램 / 포트폴리오 설정
# 2) BTC 전용 전략
# 3) 공통 알트 전략
# 4) 분석 / 수집 설정
#
# =========================
# OKX 설정
# =========================
OKX_API_KEY=YOUR_OKX_API_KEY
OKX_API_SECRET=YOUR_OKX_API_SECRET
OKX_API_PASSPHRASE=YOUR_OKX_API_PASSPHRASE
OKX_SANDBOX=false
OKX_TRADE_RISK_PER_TRADE=1.0
OKX_FEE_RATE_PCT=0.1
OKX_MIN_BUY_ORDER_VALUE=1.0
OKX_MAX_DAILY_LOSS_QUOTE=5.0
OKX_REQUEST_RETRY_COUNT=2
OKX_REQUEST_RETRY_DELAY_SEC=1.0
OKX_REQUEST_TIMEOUT_MS=15000
OKX_ALT_SYMBOLS=ETH/USDT,XRP/USDT,SOL/USDT

# =========================
# 업비트 설정
# =========================
UPBIT_API_KEY=YOUR_UPBIT_API_KEY
UPBIT_API_SECRET=YOUR_UPBIT_API_SECRET
UPBIT_TRADE_RISK_PER_TRADE=1.0
UPBIT_FEE_RATE_PCT=0.05
UPBIT_MIN_BUY_ORDER_VALUE=5000
UPBIT_MAX_DAILY_LOSS_QUOTE=5000
UPBIT_REQUEST_RETRY_COUNT=3
UPBIT_REQUEST_RETRY_DELAY_SEC=1.2
UPBIT_REQUEST_TIMEOUT_MS=20000
UPBIT_BALANCE_CACHE_TTL_SEC=1.0
UPBIT_ORDERBOOK_CACHE_TTL_SEC=0.8
UPBIT_BEST_BID_REFRESH_BUFFER_PCT=0.30
UPBIT_WEBSOCKET_URL=wss://api.upbit.com/websocket/v1
UPBIT_WS_RECONNECT_DELAY_SEC=3.0
UPBIT_WS_PING_INTERVAL_SEC=20.0
UPBIT_WS_LATEST_WRITE_INTERVAL_SEC=0.4
UPBIT_WS_ENABLE_TRADE=true
UPBIT_WS_ENABLE_ORDERBOOK=true
UPBIT_WS_ENABLE_CANDLE_1M=true
UPBIT_PRIVATE_WEBSOCKET_URL=wss://api.upbit.com/websocket/v1/private
UPBIT_WS_ENABLE_PRIVATE=true
UPBIT_WS_ENABLE_MYORDER=true
UPBIT_WS_ENABLE_MYASSET=true
UPBIT_WS_PROVIDER_ENABLED=true
UPBIT_WS_PROVIDER_ROOT_DIR=logs/runtime/upbit_ws
UPBIT_WS_PROVIDER_CACHE_TTL_SEC=0.25
UPBIT_WS_PROVIDER_STALE_SEC=5.0
UPBIT_KRW_ORDER_BUFFER_PCT=0.002
UPBIT_KRW_ORDER_BUFFER_KRW=1000
UPBIT_ALT_SYMBOLS=XRP/KRW,ETH/KRW,SOL/KRW

# =========================
# 텔레그램 설정
# =========================
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
TELEGRAM_NOTIFY_BUY=true
TELEGRAM_NOTIFY_SELL=true
TELEGRAM_NOTIFY_STOP_LOSS=true
TELEGRAM_NOTIFY_ERROR=true
TELEGRAM_NOTIFY_DAILY_LIMIT=true
TELEGRAM_ENABLE_ERROR_ACTION_BUTTONS=true
TELEGRAM_COMMAND_POLL_INTERVAL_SEC=5
TELEGRAM_RECENT_LOG_LINE_COUNT=5
TELEGRAM_DAILY_REPORT_ENABLED=true
TELEGRAM_DAILY_REPORT_MORNING_HOUR=8
TELEGRAM_DAILY_REPORT_NOON_HOUR=12
TELEGRAM_DAILY_REPORT_EVENING_HOUR=18
TELEGRAM_DAILY_REPORT_NIGHT_HOUR=21
TELEGRAM_WEEKLY_REPORT_ENABLED=true
TELEGRAM_WEEKLY_REPORT_WEEKDAY=MON
TELEGRAM_WEEKLY_REPORT_HOUR=9

# =========================
# 포트폴리오 배분 설정
# =========================
PORTFOLIO_TARGET_ALLOCATIONS=BTC:0.45,ETH:0.30,XRP:0.15,SOL:0.10
PORTFOLIO_ENABLE_DYNAMIC_OVERWEIGHT=true
PORTFOLIO_DYNAMIC_MAX_BONUS_PCT=0.05
PORTFOLIO_DYNAMIC_VOLUME_RATIO_THRESHOLD=2.00
PORTFOLIO_DYNAMIC_REQUIRE_TREND_OK=true
PORTFOLIO_DYNAMIC_REQUIRE_STRONG_SIGNAL=true
MARKET_GUARD_ENABLE_LOW_ENERGY=true
MARKET_GUARD_LOW_ENERGY_AVG_VOLUME_RATIO=0.80
MARKET_GUARD_LOW_ENERGY_AVG_ABS_CHANGE_PCT=0.05
MARKET_GUARD_LOW_ENERGY_REQUIRE_READY_COUNT_ZERO=true
MARKET_GUARD_LOW_ENERGY_MAX_RECORD_AGE_SEC=180
REGIME_BREAKOUT_VOLUME_RATIO_THRESHOLD=1.20
REGIME_BREAKOUT_GAP_PCT_THRESHOLD=0.12
REGIME_TRENDING_VOLUME_RATIO_THRESHOLD=1.00
REGIME_TRENDING_AVG_ABS_CHANGE_PCT_THRESHOLD=0.08
REGIME_EXHAUSTION_RSI_THRESHOLD=80
REGIME_OVERHEATED_RSI_THRESHOLD=90
REGIME_OVERHEATED_VOLUME_RATIO_THRESHOLD=1.50
REGIME_ALERT_MIN_INTERVAL_SEC=900
REGIME_ALERT_ENABLED=false

# =========================
# BTC 전용 EMA 전략
# =========================

# -------------------------
# BTC 버전 / 시간축
# -------------------------
BTC_TREND_VERSION=btc_mid_v1
BTC_TREND_ENTRY_MODE=donchian
BTC_TREND_DONCHIAN_ENTRY_LOOKBACK=20
BTC_TREND_DONCHIAN_EXIT_LOOKBACK=10
BTC_TREND_DONCHIAN_CONFIRM_BREAKOUT_CLOSE=true
BTC_TREND_TIMEFRAME=5m
BTC_TREND_CONFIRM_TIMEFRAME=15m
BTC_TREND_ENABLE_CONFIRM_FILTER=true
BTC_TREND_FAST_EMA_PERIOD=9
BTC_TREND_SLOW_EMA_PERIOD=21
BTC_TREND_CONFIRM_EMA_PERIOD=13
BTC_TREND_ENABLE_TREND_FOLLOW_ENTRY=true
BTC_TREND_REQUIRE_PRICE_ABOVE_FAST=true

# -------------------------
# BTC 진입 품질 필터
# -------------------------
BTC_TREND_MIN_EMA_SPREAD_PCT=0.020
BTC_TREND_MIN_EMA_SPREAD_PCT_MAP=BTC/USDT:0.030,BTC/KRW:0.030
BTC_TREND_ENABLE_FEE_PROTECT_EXIT=true
BTC_TREND_FEE_PROTECT_MIN_NET_PNL_PCT=0.12
BTC_TREND_ENABLE_BULL_PULLBACK_HOLD=true
BTC_TREND_BULL_PULLBACK_TOLERANCE_PCT=0.20
BTC_TREND_BULL_PULLBACK_MIN_SPREAD_PCT=0.10
BTC_TREND_ATR_PERIOD=14
BTC_TREND_MIN_ATR_PCT=0.07
BTC_TREND_MIN_ATR_PCT_MAP=BTC/KRW:0.09
BTC_TREND_MAX_ATR_PCT=2.50
BTC_TREND_VOLUME_LOOKBACK=20
BTC_TREND_MIN_VOLUME_RATIO=1.45
BTC_TREND_MIN_VOLUME_RATIO_MAP=BTC/USDT:1.70
BTC_TREND_CHOPPY_MIN_VOLUME_RATIO_MAP=BTC/USDT:2.00,BTC/KRW:2.00
BTC_TREND_POSITION_RATIO=0.25
BTC_TREND_POSITION_RATIO_MAP=BTC/USDT:0.60,BTC/KRW:0.60
BTC_TREND_ENABLE_REGIME_POSITION_SCALING=true
BTC_TREND_REGIME_POSITION_SCALE_MAP=TRENDING:1.10,BREAKOUT_ATTEMPT:0.90,CHOPPY:0.50,LOW_ENERGY:0.00,OVERHEATED:0.30,EXHAUSTION_RISK:0.00
BTC_TREND_ENABLE_ATR_POSITION_SCALING=true
BTC_TREND_ATR_POSITION_SCALE_THRESHOLD_MAP=0.16:0.80,0.13:0.60,0.10:0.35

# -------------------------
# BTC 포지션 크기 / 재진입 / 청산
# -------------------------
BTC_TREND_MIN_ORDER_AMOUNT=0.00001
BTC_TREND_MIN_TRADE_INTERVAL_SEC=300
BTC_TREND_STOP_LOSS_REENTRY_COOLDOWN_SEC=900
BTC_TREND_PROFIT_EXIT_REENTRY_COOLDOWN_SEC=600
BTC_TREND_ENABLE_PARTIAL_TAKE_PROFIT=true
BTC_TREND_PARTIAL_TAKE_PROFIT_RATIO=0.4
BTC_TREND_ENABLE_PYRAMID_ADD_ON=true
BTC_TREND_PYRAMID_TRIGGER_PROFIT_PCT=0.35
BTC_TREND_PYRAMID_POSITION_RATIO=0.15
BTC_TREND_PYRAMID_MAX_ADD_ONS=1
BTC_TREND_STOP_MODE=atr
BTC_TREND_TAKE_PROFIT_MODE=atr
BTC_TREND_STOP_ATR_MULTIPLE=1.5
BTC_TREND_TAKE_PROFIT_ATR_MULTIPLE=1.8
BTC_TREND_TRAILING_DRAWDOWN_PCT=0.6
BTC_TREND_SWING_LOOKBACK=10
BTC_TREND_EXIT_ON_BEARISH_CROSS=true
BTC_TREND_LOOP_INTERVAL_SEC=10

# =========================
# 공통 알트 전략
# =========================

# -------------------------
# 공통 알트 버전 / 진입 기본
# -------------------------
STRATEGY_VERSION=alt_live_v1
STRATEGY_ENTRY_MODE=squeeze
STRATEGY_BB_PERIOD=20
STRATEGY_BB_STDDEV=2.0
STRATEGY_SQUEEZE_MAX_BANDWIDTH_PCT=0.60
STRATEGY_SQUEEZE_MIN_VOLUME_RATIO=1.80
STRATEGY_BUY_SPLIT_RATIO=0.10
STRATEGY_SELL_SPLIT_RATIO=0.10
STRATEGY_MAX_ENTRY_COUNT=2
STRATEGY_MIN_TRADE_INTERVAL_SEC=300
STRATEGY_ENABLE_TREND_FOLLOW_ENTRY=false
STRATEGY_TREND_FOLLOW_REQUIRE_PREV_ABOVE_MA=true
STRATEGY_TREND_FOLLOW_REQUIRE_PRICE_RISING=true
STRATEGY_ENABLE_HIGHER_TIMEFRAME_FILTER=true
STRATEGY_HIGHER_TIMEFRAME=5m
STRATEGY_HIGHER_TIMEFRAME_MA_PERIOD=20
STRATEGY_BLOCK_ENTRY_WHEN_HTF_BEARISH_SYMBOLS=XRP/KRW,ETH/USDT

# -------------------------
# 공통 알트 품질 필터 / 포지션 스케일
# -------------------------
STRATEGY_ENABLE_VOLUME_FILTER=true
STRATEGY_VOLUME_LOOKBACK=20
STRATEGY_MIN_VOLUME_RATIO=0.90
STRATEGY_MIN_VOLUME_RATIO_MAP=DOGE/KRW:1.50,ETH/USDT:0.80,ETH/KRW:1.05,XRP/KRW:1.10,XRP/USDT:0.95
STRATEGY_POSITION_RATIO_MAP=XRP/KRW:0.30,ETH/USDT:0.70,ETH/KRW:0.70
STRATEGY_ENABLE_REGIME_POSITION_SCALING=true
STRATEGY_REGIME_POSITION_SCALE_MAP=TRENDING:1.00,BREAKOUT_ATTEMPT:0.80,CHOPPY:0.40,LOW_ENERGY:0.00,OVERHEATED:0.20,EXHAUSTION_RISK:0.00
STRATEGY_ENABLE_BTC_REGIME_POSITION_SCALING=true
STRATEGY_BTC_REGIME_POSITION_SCALE_MAP=LOW_ENERGY:0.50
STRATEGY_BTC_REGIME_POSITION_SCALE_OVERRIDE_MAP=ETH/KRW|LOW_ENERGY:0.35,XRP/KRW|LOW_ENERGY:0.60,ETH/USDT|LOW_ENERGY:0.35,XRP/USDT|LOW_ENERGY:0.60
STRATEGY_ENABLE_BTC_ATR_POSITION_SCALING=true
STRATEGY_BTC_ATR_POSITION_SCALE_LOOKBACK=14
STRATEGY_BTC_ATR_POSITION_SCALE_THRESHOLD_MAP=0.18:0.70,0.15:0.45,0.12:0.25
STRATEGY_ENABLE_VOLATILITY_FILTER=true
STRATEGY_VOLATILITY_LOOKBACK=20
STRATEGY_MIN_VOLATILITY_PCT=0.03
STRATEGY_MAX_VOLATILITY_PCT=5.0
STRATEGY_MIN_CROSSOVER_GAP_PCT=1.2
STRATEGY_MIN_CROSSOVER_GAP_PCT_MAP=BTC/USDT:0.15,PI/USDT:1.00,BTC/KRW:0.15,XRP/KRW:0.03,DOGE/KRW:0.50,ETH/USDT:0.08,ETH/KRW:0.12,XRP/USDT:0.10
STRATEGY_MIN_ORDER_AMOUNT_MAP=PI/USDT:1.0,ETH/USDT:0.0001
STRATEGY_AVERAGING_DOWN_GAP_PCT=3.0

# -------------------------
# 공통 알트 청산 / 보호 장치
# -------------------------
STRATEGY_MIN_TAKE_PROFIT_PCT=1.0
STRATEGY_MIN_TAKE_PROFIT_PCT_MAP=BTC/USDT:1.00,PI/USDT:3.20,BTC/KRW:1.00,XRP/KRW:0.45,DOGE/KRW:1.00,ETH/USDT:1.05,ETH/KRW:0.75,XRP/USDT:0.60
STRATEGY_ENABLE_FEE_PROTECT_EXIT=true
STRATEGY_FEE_PROTECT_MIN_NET_PNL_PCT=0.15
STRATEGY_FEE_PROTECT_MIN_NET_PNL_PCT_MAP=ETH/USDT:0.08,XRP/KRW:0.16,XRP/USDT:0.18
STRATEGY_ENABLE_BREAK_EVEN_GUARD=true
STRATEGY_BREAK_EVEN_GUARD_MIN_MFE_PCT=0.00
STRATEGY_BREAK_EVEN_GUARD_MIN_MFE_PCT_MAP=ETH/USDT:0.12,ETH/KRW:0.20
STRATEGY_BREAK_EVEN_GUARD_FLOOR_NET_PNL_PCT=0.00
STRATEGY_BREAK_EVEN_GUARD_FLOOR_NET_PNL_PCT_MAP=ETH/USDT:0.20,ETH/KRW:0.08
STRATEGY_STOP_LOSS_PCT=1.5
STRATEGY_STOP_LOSS_PCT_MAP=BTC/USDT:0.80,PI/USDT:2.20,BTC/KRW:0.80,XRP/KRW:1.20,DOGE/KRW:1.00,ETH/USDT:0.90,ETH/KRW:0.90,XRP/USDT:1.10
STRATEGY_PARTIAL_TAKE_PROFIT_SYMBOLS=ETH/USDT,ETH/KRW,XRP/KRW
STRATEGY_PARTIAL_STOP_LOSS_SYMBOLS=ETH/USDT,ETH/KRW
STRATEGY_PARTIAL_TP_REENTRY_COOLDOWN_SEC=900
STRATEGY_PARTIAL_TP_RATIO=0.5
STRATEGY_PARTIAL_SL_RATIO=0.5
STRATEGY_LOOP_INTERVAL_SEC=10

# =========================
# 분석 수집 설정
# =========================
ANALYSIS_LOG_INTERVAL_SEC=10
ANALYSIS_TIMEFRAME=1m
ANALYSIS_MA_PERIOD=20
ANALYSIS_VOLUME_LOOKBACK=20
ANALYSIS_VOLATILITY_LOOKBACK=20
ANALYSIS_RECENT_RANGE_LOOKBACK=20
ANALYSIS_RSI_PERIOD=14
ANALYSIS_ENABLE_ORDERBOOK=true
ANALYSIS_OKX_SYMBOLS=SOL/USDT
ANALYSIS_UPBIT_SYMBOLS=SOL/KRW
